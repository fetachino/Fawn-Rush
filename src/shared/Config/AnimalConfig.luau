function AnimalConfig.get(animalId: string)
	return AnimalConfig.animals[animalId] or AnimalConfig.animals.deer
end

-- Validates the cast. Called at boot; a failure here means a broken save later, so it is loud.
function AnimalConfig.validate(): { string }
	local problems = {}

	for _, animalId in ipairs(AnimalConfig.ORDER) do
		local animal = AnimalConfig.animals[animalId]
		if not animal then
			problems[#problems + 1] = ("ORDER references missing animal '%s'"):format(animalId)
		end
	end

	for animalId, animal in pairs(AnimalConfig.animals) do
		if animal.id ~= animalId then
			problems[#problems + 1] = ("animal '%s' has mismatched id '%s'"):format(animalId, tostring(animal.id))
		end
		if not AnimalConfig.RARITY[animal.rarity] then
			problems[#problems + 1] = ("animal '%s' has unknown rarity '%s'"):format(animalId, tostring(animal.rarity))
		end
		for key, value in pairs(animal.build) do
			if type(value) ~= "number" or value ~= value then
				problems[#problems + 1] = ("animal '%s' build.%s is not a number"):format(animalId, key)
			end
		end
		if animal.build.legLength <= 0 then
			problems[#problems + 1] = ("animal '%s' has no legs"):format(animalId)
		end
	end

	return problems
end

return AnimalConfig
